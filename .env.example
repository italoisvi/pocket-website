# Resend API Key
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=sua_chave_api_aqui

# TikTok Events API
# Gere o token em: TikTok Events Manager > Implementar API Events > Gerar token de acesso
TIKTOK_ACCESS_TOKEN=seu_token_aqui
TIKTOK_PIXEL_ID=D60F3A3C77U7EB9GUBM0

# Kiwify Webhook
# Obtenha o secret na configuração de webhooks da Kiwify
KIWIFY_WEBHOOK_SECRET=seu_secret_aqui
